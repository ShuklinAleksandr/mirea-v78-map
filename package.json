{
  "name": "mirea-spatial-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "vite build",
    "preview": "node scripts/serve.mjs preview",
    "stop": "node scripts/serve.mjs stop",
    "test": "node --test tests/*.test.mjs",
    "data:build": "python3 scripts/build-all.py",
    "data:check": "python3 scripts/check-data.py",
    "format": "prettier --write src tests docs README.md package.json vite.config.js index.html scripts/serve.mjs",
    "format:check": "prettier --check src tests package.json vite.config.js index.html scripts/serve.mjs",
    "check": "npm run format:check && npm test && npm run build",
    "mobile:sync": "npm run build -- --base / && node scripts/mobile-package.mjs && cap sync android",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:doctor": "node scripts/mobile-doctor.mjs",
    "mobile:build:android": "npm run mobile:sync && node scripts/build-android.mjs",
    "mobile:check": "node scripts/check-mobile-package.mjs",
    "test:ui": "node scripts/audit-responsive-ui.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/share": "8.0.3",
    "polygon-clipping": "0.15.7",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "axe-core": "4.14.1",
    "playwright-core": "1.65.1",
    "prettier": "3.6.2",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
